{
  "name": "personal-portfolio-angular",
  "version": "0.0.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href /Portfolio/ --configuration production",
    "build:dev": "ng build --base-href /Portfolio/ --configuration development",
    "build:prod": "ng build --base-href /Portfolio/ --configuration production --define AI_GATEWAY_API_KEY=\"'$AI_GATEWAY_API_KEY'\"",
    "deploy": "npm run build:prod && touch dist/portfolio/.nojekyll && cp src/404.html dist/portfolio/404.html",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "lint": "ng lint",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium firefox webkit"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/platform-browser": "^22.0.6",
    "rxjs": "^7.8.2",
    "three": "^0.185.1",
    "tslib": "^2.0.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/jasmine": "~3.6.0",
    "@types/node": "^24.12.2",
    "@types/three": "^0.185.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.3.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^4.6.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.59.2"
  }
}
